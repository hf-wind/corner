# ── Database ──
POSTGRES_DB=corner
POSTGRES_USER=corner
POSTGRES_PASSWORD=change_me

# ── Redis ──
REDIS_PASS=change_me_too

# ── JWT ──
JWT_SECRET=generate_a_random_string_here
JWT_EXPIRES_IN=7d

# ── Initial admin (required by prisma:seed) ──
SEED_ADMIN_USERNAME=huifeng
SEED_ADMIN_EMAIL=1833079849@qq.com
SEED_ADMIN_PASSWORD=replace_with_a_strong_password
SEED_ALLOWED_DATABASE=corner
SEED_ALLOW_REMOTE_DATABASE=false

# ── App ──
ACME_EMAIL=1833079849@qq.com
DATA_ROOT=/srv/corner/data

# ── DeepSeek AI ──
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
AI_PET_SYSTEM_PROMPT=
WEATHER_API_KEY=

# ── AMap (Phase 1 place editor) ──
AMAP_WEB_SERVICE_KEY=
VITE_AMAP_WEB_KEY=
VITE_AMAP_SECURITY_CODE=

# ── Time constellation feature flags ──
FEATURE_ALBUMS_ENABLED=true
VITE_FEATURE_ALBUMS_ENABLED=true

# ── Optional provider fallbacks ──
QWEN_API_KEY=
DASHSCOPE_API_KEY=
EMAIL_SMTP_PASS=
EMAIL_SMTP_USER=1833079849@qq.com
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=465
EMAIL_SMTP_SECURE=true
EMAIL_FROM_NAME=风隅随笔
EMAIL_FROM_ADDRESS=1833079849@qq.com

# ── Cloudflare Turnstile ──
TURNSTILE_ENABLED=true
TURNSTILE_SITE_KEY=0x4AAAAAAEBb-aIzkxa6-yRo
TURNSTILE_SECRET_KEY=
TURNSTILE_HOSTNAME=corner.ink

# ── Portable data and backups ──
BACKUP_ROOT=/srv/corner/backups
