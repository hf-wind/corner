generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  username     String   @unique @db.VarChar(50)
  email        String   @unique @db.VarChar(255)
  passwordHash String   @map("password_hash") @db.Text
  avatar       String?
  bio          String?  @db.Text
  role         String   @default("user") @db.VarChar(20)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  posts        Post[]
  media        Media[]
  chatMessages ChatMessage[]
  chatDailyQuotas ChatDailyQuota[]
  comments     Comment[]
  commentLikes CommentLike[]
  moments      Moment[]
  momentComments MomentComment[]
  momentCommentLikes MomentCommentLike[]
  momentLikes  MomentLike[]

  @@index([isActive, role])
  @@map("users")
}

model Category {
  id          String     @id @default(uuid()) @db.Uuid
  name        String     @db.VarChar(100)
  slug        String     @unique @db.VarChar(100)
  description String?    @db.Text
  icon        String?    @db.VarChar(50)
  color       String?    @db.VarChar(20)
  parentId    String?    @map("parent_id") @db.Uuid
  parent      Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryTree")
  posts       Post[]

  @@map("categories")
}

model Tag {
  id    String     @id @default(uuid()) @db.Uuid
  name  String     @db.VarChar(50)
  slug  String     @unique @db.VarChar(50)
  icon  String?    @db.VarChar(50)
  color String?    @db.VarChar(20)
  posts PostTag[]

  @@map("tags")
}

model Post {
  id          String    @id @default(uuid()) @db.Uuid
  title       String    @db.VarChar(255)
  slug        String    @unique @db.VarChar(255)
  content     String    @db.Text
  excerpt     String?   @db.Text
  coverImage  String?   @map("cover_image") @db.Text
  authorId    String    @map("author_id") @db.Uuid
  categoryId  String?   @map("category_id") @db.Uuid
  status      String    @default("draft") @db.VarChar(20)
  viewCount   Int       @default(0) @map("view_count")
  likeCount   Int       @default(0) @map("like_count")
  featured    Boolean   @default(false)
  needsPublish Boolean  @default(true) @map("needs_publish")
  publishedSnapshot Json? @map("published_snapshot")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  author      User      @relation(fields: [authorId], references: [id])
  category    Category? @relation(fields: [categoryId], references: [id])
  tags        PostTag[]
  comments    Comment[]
  visitStats  VisitStat[]

  @@index([status, publishedAt])
  @@index([publishedAt])
  @@map("posts")
}

model Moment {
  id                String          @id @default(uuid()) @db.Uuid
  title             String          @db.VarChar(255)
  slug              String          @unique @db.VarChar(255)
  content           String          @db.Text
  excerpt           String?         @db.Text
  authorId          String          @map("author_id") @db.Uuid
  status            String          @default("draft") @db.VarChar(20)
  viewCount         Int             @default(0) @map("view_count")
  likeCount         Int             @default(0) @map("like_count")
  needsPublish      Boolean         @default(true) @map("needs_publish")
  publishedSnapshot Json?           @map("published_snapshot")
  publishedAt       DateTime?       @map("published_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  author            User            @relation(fields: [authorId], references: [id])
  comments          MomentComment[]
  likes             MomentLike[]

  @@index([status, publishedAt])
  @@index([publishedAt])
  @@map("moments")
}

model PostTag {
  postId String @map("post_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@map("post_tags")
}

model Comment {
  id             String   @id @default(uuid()) @db.Uuid
  postId         String   @map("post_id") @db.Uuid
  userId         String?  @map("user_id") @db.Uuid
  authorName     String?  @map("author_name") @db.VarChar(100)
  authorEmail    String?  @map("author_email") @db.VarChar(255)
  content        String   @db.Text
  parentId       String?  @map("parent_id") @db.Uuid
  replyToName    String?  @map("reply_to_name") @db.VarChar(100)
  status         String   @default("pending") @db.VarChar(20)
  rejectReason   String?  @map("reject_reason") @db.Text
  aiReview       String?  @map("ai_review") @db.Text
  aiReviewResult String?  @map("ai_review_result") @db.VarChar(20)
  createdAt      DateTime @default(now()) @map("created_at")
  post           Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  user           User?    @relation(fields: [userId], references: [id])
  parent         Comment? @relation("CommentReply", fields: [parentId], references: [id])
  replies        Comment[] @relation("CommentReply")
  likes          CommentLike[]

  @@map("comments")
}

model CommentLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("comment_likes")
}

model MomentComment {
  id        String   @id @default(uuid()) @db.Uuid
  momentId  String   @map("moment_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  authorName String? @map("author_name") @db.VarChar(100)
  authorEmail String? @map("author_email") @db.VarChar(255)
  content   String   @db.Text
  parentId  String?  @map("parent_id") @db.Uuid
  replyToName String? @map("reply_to_name") @db.VarChar(100)
  status    String   @default("pending") @db.VarChar(20)
  rejectReason String? @map("reject_reason") @db.Text
  aiReview  String?  @map("ai_review") @db.Text
  aiReviewResult String? @map("ai_review_result") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)
  user      User?    @relation(fields: [userId], references: [id])
  parent    MomentComment? @relation("MomentCommentReply", fields: [parentId], references: [id])
  replies   MomentComment[] @relation("MomentCommentReply")
  likes     MomentCommentLike[]

  @@index([momentId, createdAt])
  @@map("moment_comments")
}

model MomentCommentLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  commentId String   @map("comment_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  comment   MomentComment @relation(fields: [commentId], references: [id], onDelete: Cascade)

  @@unique([userId, commentId])
  @@map("moment_comment_likes")
}

model MomentLike {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  momentId  String   @map("moment_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id])
  moment    Moment   @relation(fields: [momentId], references: [id], onDelete: Cascade)

  @@unique([userId, momentId])
  @@map("moment_likes")
}

model Media {
  id           String   @id @default(uuid()) @db.Uuid
  filename     String   @db.VarChar(255)
  originalName String?  @map("original_name") @db.VarChar(255)
  mimeType     String?  @map("mime_type") @db.VarChar(100)
  size         Int?
  path         String   @db.Text
  originalPath String?  @map("original_path") @db.Text
  folder       String?  @db.VarChar(100)
  uploadedBy   String?  @map("uploaded_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  uploader     User?    @relation(fields: [uploadedBy], references: [id])

  @@map("media")
}

model Setting {
  key       String   @id @db.VarChar(100)
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("settings")
}

model AiModelConfig {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(100)
  provider  String   @db.VarChar(50)
  apiKey    String   @map("api_key") @db.Text
  baseUrl   String   @map("base_url") @db.Text
  model     String   @db.VarChar(150)
  enabled   Boolean  @default(true)
  isDefault Boolean  @default(false) @map("is_default")
  sort      Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([provider, name])
  @@index([enabled, isDefault, sort])
  @@map("ai_model_configs")
}

model VisitStat {
  id        String   @id @default(uuid()) @db.Uuid
  postId    String?  @map("post_id") @db.Uuid
  ipHash    String?  @map("ip_hash") @db.VarChar(64)
  userAgent String?  @map("user_agent") @db.Text
  visitedAt DateTime @default(now()) @map("visited_at")
  post      Post?    @relation(fields: [postId], references: [id])

  @@map("visit_stats")
}

model EmojiPack {
  id               String   @id @default(uuid()) @db.Uuid
  name             String   @db.VarChar(100)
  type             String   @default("static") @db.VarChar(20)
  sort             Int      @default(0)
  enabled          Boolean  @default(true)
  compressAnimated Boolean  @default(false) @map("compress_animated")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  items            EmojiItem[]

  @@map("emoji_packs")
}

model EmojiItem {
  id      String    @id @default(uuid()) @db.Uuid
  packId  String    @map("pack_id") @db.Uuid
  label   String?   @db.VarChar(100)
  char    String?   @db.VarChar(20)
  imageUrl String?  @map("image_url") @db.Text
  sort    Int       @default(0)
  pack    EmojiPack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@map("emoji_items")
}

model ChatMessage {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  role      String   @db.VarChar(20)
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@map("chat_messages")
}

model ChatDailyQuota {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  date      DateTime @db.Date
  count     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@map("chat_daily_quota")
}

model VerificationCode {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @db.VarChar(255)
  code      String   @db.VarChar(10)
  type      String   @db.VarChar(20)
  used      Boolean  @default(false)
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([email, type, used])
  @@map("verification_codes")
}

model EmailLog {
  id        String   @id @default(uuid()) @db.Uuid
  to        String   @db.VarChar(255)
  subject   String   @db.VarChar(255)
  type      String   @db.VarChar(50)
  content   String?  @db.Text
  status    String   @default("pending") @db.VarChar(20)
  error     String?  @db.Text
  postId    String?  @map("post_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  sentAt    DateTime? @map("sent_at")

  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("email_logs")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(50)
  title     String   @db.VarChar(255)
  content   String?  @db.Text
  link      String?  @db.VarChar(500)
  read      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId, read])
  @@index([createdAt])
  @@map("notifications")
}

model FriendApplication {
  id              String   @id @default(uuid()) @db.Uuid
  siteName        String   @map("site_name") @db.VarChar(100)
  siteUrl         String   @map("site_url") @db.Text
  siteAvatar      String?  @map("site_avatar") @db.Text
  siteDescription String?  @map("site_description") @db.Text
  siteRssUrl      String?  @map("site_rss_url") @db.Text
  contactEmail    String   @map("contact_email") @db.VarChar(255)
  friendPageUrl   String   @map("friend_page_url") @db.Text
  status          String   @default("pending") @db.VarChar(20)
  aiReview        String?  @map("ai_review") @db.Text
  aiReviewResult  String?  @map("ai_review_result") @db.VarChar(20)
  rejectReason    String?  @map("reject_reason") @db.Text
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("friend_applications")
}

model LibraryItem {
  id              String    @id @default(uuid()) @db.Uuid
  type            String    @db.VarChar(20)
  title           String    @db.VarChar(255)
  originalTitle   String?   @map("original_title") @db.VarChar(255)
  slug            String    @unique @db.VarChar(255)
  coverImage      String?   @map("cover_image") @db.Text
  creator         String?   @db.VarChar(255)
  summary         String?   @db.Text
  reflection      String?   @db.Text
  highlights      Json      @default("[]")
  quotes          Json      @default("[]")
  genres          Json      @default("[]")
  cast            Json      @default("[]")
  publishStatus   String    @default("draft") @map("publish_status") @db.VarChar(20)
  progressStatus  String?   @map("progress_status") @db.VarChar(30)
  rating          Float?
  rank            Int?
  recommended     Boolean   @default(false)
  startDate       DateTime? @map("start_date") @db.Date
  finishDate      DateTime? @map("finish_date") @db.Date
  releaseYear     Int?      @map("release_year")
  country         String?   @db.VarChar(100)
  language        String?   @db.VarChar(100)
  publisher       String?   @db.VarChar(255)
  isbn            String?   @db.VarChar(30)
  totalPages      Int?      @map("total_pages")
  director        String?   @db.VarChar(255)
  runtimeMinutes  Int?      @map("runtime_minutes")
  episodeCount    Int?      @map("episode_count")
  platform        String?   @db.VarChar(100)
  sourceUrl       String?   @map("source_url") @db.Text
  viewCount       Int       @default(0) @map("view_count")
  publishedAt     DateTime? @map("published_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([type, publishStatus])
  @@index([recommended, publishedAt])
  @@map("library_items")
}
