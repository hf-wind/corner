model VisitorMessage {
  id             String               @id @default(uuid()) @db.Uuid
  type           String               @db.VarChar(10)
  content        String               @db.VarChar(200)
  nickname       String               @db.VarChar(20)
  visitorIdHash  String?              @map("visitor_id_hash") @db.VarChar(64)
  userId         String?              @map("user_id") @db.Uuid
  status         String               @default("pending") @db.VarChar(20)
  aiReview       String?              @map("ai_review") @db.Text
  aiReviewResult String?              @map("ai_review_result") @db.VarChar(20)
  rejectReason   String?              @map("reject_reason") @db.Text
  caughtByIdHash String?              @map("caught_by_id_hash") @db.VarChar(64)
  caughtAt       DateTime?            @map("caught_at")
  releasedAt     DateTime?            @map("released_at")
  originRegion   String?              @map("origin_region") @db.VarChar(100)
  currentRegion  String?              @map("current_region") @db.VarChar(100)
  catchCount     Int                  @default(0) @map("catch_count")
